{
    "name": "@sadan4/ts2json",
    "description": "A library to turn TypeScript types into JSON schema",
    "authors": "sadan",
    "version": "1.0.0",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "dependencies": {
        "typescript": "catalog:"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "vitest": "catalog:",
        "@vitest/ui": "catalog:",
        "esbuild": "0.28.2",
        "rolldown": "catalog:",
        "rolldown-plugin-dts": "catalog:",
        "zod": "catalog:"
    },
    "scripts": {
        "build": "rolldown -c",
        "test": "vitest run",
        "test:ui": "vitest --ui",
        "typecheck": "tsc --noEmit -p ./tsconfig.json"
    }
}
