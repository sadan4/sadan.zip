{
    "compilerOptions": {
        "module": "ESNext",
        "moduleResolution": "bundler",
        "target": "ESNext",
        "lib": [
            "ESNext"
        ],
        "types": [
            "node"
        ],
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noEmit": true,
        "skipLibCheck": true,
        "declaration": true,
        "isolatedDeclarations": true,
        "stripInternal": true,
    },
    "include": [
        "src",
        "vitest.config.ts",
        "rolldown.config.ts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}
