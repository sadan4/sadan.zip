    "lucide",
    "MACCHIATO",
    "maddie",
    "memmem",
    "miette",
    "minky",
    "Minky",
    "mugman",
    "napi",
    "nontrapping",
    "noopener",
    "NORD",
    "noreferrer",
    "noselect",
    "Onig",
    "Onigasm",
    "pannable",
    "PATHEXT",
    "peekable",
    "pife",
    "Popout",
    "quasis",
    "ruid",
    "rushii",
    "sema",
    "serde",
    "shiki",
    "shikijs",
    "Smol",
    "smolstr",
    "smth",
    "sqaaakoi",
    "strs",
    "syntect",
    "thiserror",
    "Threadsafe",
    "userplugins",
    "vencord",
    "vite",
    "worf",
    "wreq",
    "zoomable",
    "zoot"
  ],
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "css.lint.unknownAtRules": "ignore",
  "js/ts.tsserver.experimental.enableProjectDiagnostics": true,
  "js/ts.experimental.useTsgo": true,
  "scss.showErrors": true,
  "scss.format.spaceAroundSelectorSeparator": true,
  "eslint.lintTask.enable": true,
  "eslint.lintTask.command": "pnpm lint:js",
  "eslint.lintTask.options": "",
  // done by stylelint, which supports ignoring with a comment in the block
  "scss.lint.emptyRules": "ignore",
  "stylelint.validate": [
    "css",
    "postcss",
    "scss"
  ],
  "[css]": {
    "editor.codeActionsOnSave": {
      "source.fixAll.stylelint": "always",
    }
  },
  "[scss]": {
    "editor.codeActionsOnSave": {
      "source.fixAll.stylelint": "always",
    }
  },
  "tailwindCSS.classFunctions": [
    "cn"
  ],
  "rust-analyzer.check.command": "clippy",
  "rust-analyzer.checkOnSave": true,
  "rust-analyzer.procMacro.ignored": {
    "napi-derive": [
      "module_init"
    ]
  },
  "rust-analyzer.imports.prefix": "crate",
  "oxc.enable.oxlint": true,
  "oxc.enable.oxfmt": false,
}