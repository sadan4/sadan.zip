{
  "search.exclude": {
    "**/routeTree.gen.ts": true,
    "crates/webpack_ast_parser/src/tests/.modules/**": true,
    "crates/webpack_chunk_parser/src/test_data/**": true,
  },
  "files.readonlyInclude": {
    "**/routeTree.gen.ts": true
  },
  "vite.autoStart": false,
  "vite.browserType": "system",
  "cSpell.words": [
    "autofocus",
