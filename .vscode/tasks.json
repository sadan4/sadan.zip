{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Watch",
            "type": "shell",
            "command": "pnpm",
            "args": ["dev"],
            "problemMatcher": [
                "$tsc"
            ],
            "isBackground": true,
            "presentation": {
                "reveal": "always"
            },
            "group": "build"
        },
        {
			"type": "eslint",
			"problemMatcher": [
				"$eslint-stylish"
			],
			"label": "eslint: lint whole folder"
		},
    ]
}
