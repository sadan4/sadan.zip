{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Watch",
            "type": "shell",
            "command": "pnpm",
            "args": [
                "dev"
            ],
            "problemMatcher": [
                "$tsc"
            ],
            "isBackground": true,
            "presentation": {
                "reveal": "always"
            },
            "group": "build"
        },
        {
            "type": "eslint",
            "problemMatcher": [
                "$eslint-stylish"
            ],
            "label": "eslint: lint whole folder"
        },
        {
            "label": "build:vencord-companion",
            "type": "shell",
            "command": "cargo",
            "args": [
                "run",
                "-p",
                "xtask",
                "--",
                "build",
                "extension",
                "--dev"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "panel": "new",
                "close": true,
                "clear": true
            }
        }
    ]
}