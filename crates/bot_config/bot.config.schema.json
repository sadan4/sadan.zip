{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Config",
  "description": "Bot config. Read from `.bot.config.json`",
  "type": "object",
  "properties": {
    "bot_owners": {
      "description": "Users who can use owner-only commands",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "build_archive_url": {
      "description": "The url for the build archive",
      "type": "string"
    },
    "emojis": {
      "description": "The emojis available for the bot to access",
      "$ref": "#/$defs/Emojis"
    },
    "home_guild_id": {
      "type": "string"
    },
    "token": {
      "description": "The bot token",
      "type": "string"
    },
    "use_ansi_clap_errors": {
      "description": "If true, clap errors will be rendered in an ANSI codeblock\n\nif false, they will just use plain text",
      "type": "boolean"
    },
    "use_local_build_cache": {
      "description": "If true, cache local builds for faster startup time.",
      "type": "boolean"
    },
    "vencord_path": {
      "description": "The path of the vencord repo, used for testing PRs",
      "type": "string"
    }
  },
  "required": [
    "token",
    "home_guild_id",
    "use_ansi_clap_errors",
    "bot_owners",
    "vencord_path",
    "build_archive_url",
    "use_local_build_cache",
    "emojis"
  ],
  "$defs": {
    "EmojiDef": {
      "description": "an emoji available for the bot to access",
      "type": "object",
      "properties": {
        "animated": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id"
      ]
    },
    "Emojis": {
      "type": "object",
      "properties": {
        "empty": {
          "description": "A 1x1 transparent image",
          "$ref": "#/$defs/EmojiDef"
        }
      },
      "required": [
        "empty"
      ]
    }
  }
}
